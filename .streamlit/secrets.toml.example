# Copy to .streamlit/secrets.toml and fill in. Never commit the real file.

GEMINI_API_KEY = ""   # only needed for ingestion/get_gemini_summary.py

[auth]
# The host here must be the host people open the app on. localhost and
# 127.0.0.1 are DIFFERENT hosts to the browser - pick one and register exactly
# this URI under "Authorised redirect URIs" in Google Cloud Console.
# "{port}" is filled in by Streamlit with server.port.
redirect_uri = "http://127.0.0.1:{port}/oauth2callback"
cookie_secret = ""    # long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Only show CEEW Workspace accounts in Google's account chooser
# (config/access.py still enforces the domain server-side).
[auth.client_kwargs]
hd = "ceew.in"
prompt = "select_account"
